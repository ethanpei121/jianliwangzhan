# 复制此文件为 .env.local（本地开发）或 .env.production（生产构建）后填入真实值。
# 注意：只有 NEXT_PUBLIC_ 前缀的变量会打包进浏览器，其余均为服务端专用。

# ─── Clerk 用户认证 ───
# https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/builder
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/builder

# ─── MySQL 数据存储 ───
# 建库建表：先配好下面几项，再执行 npm run init:db（等价于 node scripts/init-db.mjs）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=jianliwangzhan

# 安全建议：生产环境不要用 root。建一个只够用的账号：
#   CREATE USER 'jianli'@'%' IDENTIFIED BY '强密码';
#   GRANT SELECT, INSERT, UPDATE ON jianliwangzhan.* TO 'jianli'@'%';
#   FLUSH PRIVILEGES;

# ─── 阿里云百炼（DashScope）AI 优化 ───
# https://bailian.console.aliyun.com -> API Key
ALIYUN_API_KEY=
